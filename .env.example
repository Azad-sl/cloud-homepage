# ====== Cloud Home 部署所需环境变量 ======
# 复制本文件为 .env.local（本地开发）或填入 Vercel 项目的 Environment Variables（线上部署）。
#
# 1) Upstash Redis 凭证（来自 Upstash 控制台 REST API 部分）：
#    https://console.upstash.com/ → 进入你的 Redis 实例 → REST API
#
#    在 Vercel 上如果你用 Storage 面板一键集成 Upstash，Vercel 会自动注入：
#      KV_REST_API_URL   = https://<your-instance>.upstash.io
#      KV_REST_API_TOKEN = <your-token>
#
#    （也兼容老的命名 UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN）

KV_REST_API_URL=
KV_REST_API_TOKEN=

# 2) 管理后台密码（可选但强烈推荐设置）。
#    设置后，所有写操作（保存设置 / 上传头像）都需要此密码。
#    密码由服务器验证，不会出现在前端代码或 API 响应中。
#    留空 = 任何人都可以修改你的主页（仅建议在本地调试时留空）。
#
#    建议用一段随机字符串，例如：
#      ADMIN_PASSWORD=my-s3cret-pass-2026

ADMIN_PASSWORD=

# 以下变量是兼容别名（不需要填写，留作参考）：
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
